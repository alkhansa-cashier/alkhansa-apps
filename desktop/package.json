{
  "name": "alkhansa-desktop",
  "version": "1.1.0",
  "description": "AlKhansa Cashier for Windows",
  "author": "KH Tech & Design",
  "main": "main.js",
  "private": true,
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.khansaa.desktop",
    "productName": "AlKhansa",
    "files": [
      "main.js",
      "preload.js",
      "app/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AlKhansa"
    }
  }
}